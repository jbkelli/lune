PORT=3000
JWT_SECRET=put-a-long-random-string-here
BASE_URL=https://your-live-domain.com

# Where every paid order is emailed (her work email)
OWNER_EMAIL=owner@phelbeauty.com
# SMTP used to send those emails (for Gmail/Workspace use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=owner@phelbeauty.com
SMTP_PASS=app-password-here

# demo = fake payment confirms after 6s (for testing) | sandbox | live
MPESA_ENV=demo
MPESA_KEY=
MPESA_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

# Owner dashboard login at /admin.html. Only this one account can log in; there is no signup.
ADMIN_EMAIL=
ADMIN_PASSWORD=
